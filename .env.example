# LLM Provider Configuration
# Choose one: groq | openai | gemini | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (Alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (Local open-source, no key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# OLLAMA_HOST=http://localhost:11434

# ── Deployment (Production only) ──────────────────────────────────────────────
# Set on Railway to restrict CORS to your Vercel frontend domain.
# Comma-separated list of allowed origins.
# Leave unset or set to "*" for local development (open access).
# Example: ALLOWED_ORIGINS=https://zomato-concierge-ai.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*
